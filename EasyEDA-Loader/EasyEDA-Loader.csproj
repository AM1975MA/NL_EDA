<Project Sdk="Microsoft.NET.Sdk">
  <!-- NL_EDA: candidate build for AD26 / DevExpress 25.2; runtime compatibility is not verified. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>EasyEDA-Loader</AssemblyName>
    <RootNamespace>EasyEDA_Loader</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AltiumInstallDir Condition="'$(AltiumInstallDir)' == '' and '$(NL_ALTIUM_HOME)' != ''">$(NL_ALTIUM_HOME)</AltiumInstallDir>
    <AltiumInstallDir Condition="'$(AltiumInstallDir)' == ''">C:\Program Files\Altium\AD23</AltiumInstallDir>
    <AltiumSystemDir>$(AltiumInstallDir)\System</AltiumSystemDir>
    <DevExpressDir>$(AltiumSystemDir)\DotNet\DevExpress.Wpf</DevExpressDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Altium.Controls"><HintPath>$(AltiumSystemDir)\Altium.Controls.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Altium.Controls.Skins"><HintPath>$(AltiumInstallDir)\Altium.Controls.Skins.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Altium.SDK"><HintPath>$(AltiumSystemDir)\Altium.SDK.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Altium.SDK.Interfaces"><HintPath>$(AltiumSystemDir)\Altium.SDK.Interfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Data.v25.2"><HintPath>$(DevExpressDir)\DevExpress.Data.v25.2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Mvvm.v25.2"><HintPath>$(DevExpressDir)\DevExpress.Mvvm.v25.2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Printing.v25.2.Core"><HintPath>$(DevExpressDir)\DevExpress.Printing.v25.2.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Utils.v25.2"><HintPath>$(DevExpressDir)\DevExpress.Utils.v25.2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Xpf.Core.v25.2"><HintPath>$(DevExpressDir)\DevExpress.Xpf.Core.v25.2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Xpf.Grid.v25.2.Core"><HintPath>$(DevExpressDir)\DevExpress.Xpf.Grid.v25.2.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Xpf.Grid.v25.2"><HintPath>$(DevExpressDir)\DevExpress.Xpf.Grid.v25.2.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="NLValidateAltiumReferences" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(AltiumSystemDir)\Altium.SDK.dll')" Text="Altium SDK not found. Set NL_ALTIUM_HOME to the Altium installation directory." />
    <Error Condition="!Exists('$(AltiumInstallDir)\Altium.Controls.Skins.dll')" Text="Altium.Controls.Skins.dll not found in Altium install root." />
    <Error Condition="!Exists('$(DevExpressDir)\DevExpress.Xpf.Core.v25.2.dll')" Text="DevExpress 25.2 not found. This experimental build uses DevExpress 25.2." />
  </Target>
  <ItemGroup>
    <Content Include="EasyEDA-Loader.Ins"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Include="EasyEDA-Loader.rcs"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <EmbeddedResource Remove="Properties\licenses.licx" />
    <None Remove="packages.config" />
  </ItemGroup>
</Project>
